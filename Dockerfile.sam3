FROM nvidia/cuda:12.6.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

ARG HUGGING_FACE_TOKEN
ENV HUGGING_FACE_TOKEN=$HUGGING_FACE_TOKEN

# 1. System Dependencies & Python 3.12
# Ubuntu 24.04 ships with Python 3.12 as default
RUN apt-get update && apt-get install -y \
    libgl1 libegl1 git wget \
    python3 python3-pip python3-dev python3-venv \
    ffmpeg libsm6 libxext6 build-essential \
    squashfuse fuse \
    && rm -rf /var/lib/apt/lists/*

# Fix for PEP 668: Break system packages to allow pip install globally
# This is acceptable in a containerized environment
RUN rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

# Ensure python points to python3
RUN ln -sf /usr/bin/python3 /usr/bin/python

# 2. PyTorch 2.7.0 (CUDA 12.6)
# According to SAM 3 README:
RUN pip install torch==2.7.0 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126

# 3. SAM 3 (Segment Anything 3)
# Clone the repository and install dependencies first
RUN git clone https://github.com/facebookresearch/sam3.git /workspace/sam3
WORKDIR /workspace/sam3
RUN pip install -e .

# 4. Common Utilities (MagicDrive context)
RUN pip install "numpy<2.0" opencv-python matplotlib scikit-image tqdm imageio nuscenes-devkit huggingface_hub einops decord psutil

WORKDIR /workspace
CMD ["/bin/bash"]
